{
  "experiment": {
    "name": "day5_check",
    "seed": 42,
    "device": "cpu"
  },
  "data": {
    "dataset": "synthetic",
    "samples_per_client": 4,
    "batch_size": 4
  },
  "model": {
    "width": 4,
    "classes": 3,
    "drop_path": 0,
    "classifier_dropout": 0
  },
  "federation": {
    "clients": 2,
    "participants": 2,
    "rounds": 1,
    "checkpoint_every": 1
  },
  "training": {
    "local_epochs": 1
  },
  "allocation": {
    "policy": "fixed",
    "fixed_start": 3,
    "fixed_end": 6
  },
  "distillation": {
    "weight_mode": "fixed",
    "fixed_weight": 1
  },
  "environment": {
    "memory_min_mb": 120,
    "memory_max_mb": 120,
    "change_probability": 0
  }
}